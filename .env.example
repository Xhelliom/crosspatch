OPENROUTER_API_KEY=sk-or-...        # orchestrateur : idéation et proposition

# Clé de l'agent *évalué*, injectée dans le sandbox. Distincte et plafonnée
# bas : ce secret vit dans un environnement qui exécute du code généré.
AGENT_OPENROUTER_API_KEY=sk-or-...
E2B_API_KEY=e2b_...
CONTROL_TOKEN=            # openssl rand -hex 32

# Pour le serveur MCP, si l'API n'est pas en local :
# CROSSPATCH_API=https://<ton-app>
